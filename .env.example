# Application environment; the original Python calculator does not consume it.
# Windows setup: scripts/setup-local.ps1 creates .env with local secrets.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:4000
API_PORT=4000
NEXT_TELEMETRY_DISABLED=1
DEMO_PASSWORD=
DISPLAY_TIMEZONE=Europe/Moscow
DEFAULT_CURRENCY=RUB

# Fill with development-only values. Empty values must fail app startup
# when the corresponding integration is enabled.
DATABASE_URL=
SESSION_SECRET=
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

STORAGE_ENABLED=false
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

TELEMATICS_ENABLED=false
TELEMATICS_API_URL=
TELEMATICS_API_TOKEN=

# Optional future AI feature. Codex sign-in is configured separately.
AI_FEATURES_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
